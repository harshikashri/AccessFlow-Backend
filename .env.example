PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/accessflow

JWT_ACCESS_SECRET=replace_with_a_strong_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_strong_random_secret

ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

CLIENT_URL=http://localhost:5173

# Keep false unless the deployment has a known, trusted reverse-proxy topology.
# Set to a hop count (for example 1) or trusted proxy IP/subnet list when needed.
TRUST_PROXY=false

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
COOKIE_PATH=/api/auth

BCRYPT_SALT_ROUNDS=12
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
LOGIN_ACCOUNT_RATE_LIMIT_MAX=8
FORGOT_PASSWORD_ACCOUNT_RATE_LIMIT_MAX=5
PASSWORD_RESET_RATE_LIMIT_MAX=10
SENSITIVE_OPERATION_RATE_LIMIT_MAX=30
BULK_OPERATION_RATE_LIMIT_MAX=8

EMAIL_PROVIDER=resend
RESEND_API_KEY=replace_with_resend_api_key
EMAIL_FROM=AccessFlow <onboarding@resend.dev>
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENT=your-registered-resend-email@example.com

SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
